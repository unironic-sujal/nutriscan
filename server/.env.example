PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nutriscan?retryWrites=true&w=majority
NODE_ENV=development
# Production: set to your Vercel frontend URL (e.g. https://nutriscan.vercel.app)
CLIENT_URL=http://localhost:5173
# Secret key required in X-API-Key header to POST /api/product
API_SECRET=change-me-to-a-strong-random-secret
